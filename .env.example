# =============================================================================
# MasteryLMS Environment Variables Template
# Copy this file to `.env` and fill in your real values (never commit `.env`).
# =============================================================================

# --- Supabase (Project Settings -> API & Database) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Postgres Connection Pooler (Session/Transaction pooler URI for backend services)
# Note: If your password contains special characters like '@', URL-encode them (e.g. '%40')
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Gateway ---
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# --- gRPC Service Addresses ---
COURSE_GRPC_URL=0.0.0.0:50051
ASSESSMENT_GRPC_URL=0.0.0.0:50052
MASTERY_GRPC_URL=0.0.0.0:50053

# Client targets used by the Gateway (and inter-service calls)
# In Docker Compose, replace localhost with the container names: course-svc, assessment-svc, mastery-svc
COURSE_SERVICE_TARGET=localhost:50051
ASSESSMENT_SERVICE_TARGET=localhost:50052
MASTERY_SERVICE_TARGET=localhost:50053

# --- Redis (Heatmap Cache + Event Queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# In production / cloud Redis (e.g. Upstash, AWS ElastiCache):
# REDIS_URL=rediss://default:password@your-redis-host:6379

# --- Odoo 17 ERP Integration (Step 4b) ---
ODOO_PORT=8069
ODOO_WEBHOOK_SECRET=odoo-mastery-lms-secret-2026

# --- Frontend (Next.js 16) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
